# Скопируй в .env для локального запуска. Реальные значения в репозиторий не попадают.
DATABASE_URL=postgres://zayavki:password@localhost:5432/zayavki
PORT=8080
# Сколько прокси стоит перед сервером (в Яндекс Облаке обычно 1). Локально без прокси поставь 0.
TRUST_PROXY_HOPS=0
# Только для разработки и staging: коды входа печатаются в лог. В production не запустится.
CODE_PROVIDER=console
AUTH_PEPPER=change-me

# Понадобятся на следующих шагах (в боевой среде задаются переменными окружения контейнера):
# MS_TOKEN=
# YC_SA_KEY=
# YC_FOLDER_ID=
